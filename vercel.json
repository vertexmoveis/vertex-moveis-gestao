{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "public": true,
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/file-retention",
      "schedule": "30 9 * * *"
    }
  ]
}
