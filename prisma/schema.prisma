generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                String                 @id @default(cuid())
  name              String
  email             String                 @unique
  password          String
  role              String                 @default("MANAGER")
  active            Boolean                @default(true)
  sessionVersion    Int                    @default(1)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  twoFactorEnabled  Boolean                @default(false)
  twoFactorSecret   String?
  avatar            String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  projects          Project[]
  quotes            Quote[]
  quoteGroups       QuoteGroup[]
  clients           Client[]
  notes             Note[]
  activities        ActivityLog[]
  paymentHistory    PaymentHistory[]
  expensesCreated   ProjectExpense[]       @relation("ExpenseCreatedBy")
  contractsCreated  ProjectContract[]      @relation("ContractCreatedBy")
  contractWaivers   Project[]              @relation("ContractWaivedBy")
  warrantyCreated   WarrantyTicket[]       @relation("WarrantyCreatedBy")
  warrantyAssigned  WarrantyTicket[]       @relation("WarrantyAssignedTo")
  loginEvents       LoginEvent[]
  cutPiecesCreated  ProjectCutPiece[]      @relation("CutPieceCreatedBy")
  timeEntries       ProjectTimeEntry[]
  qualityChecks     ProjectQualityCheck[]  @relation("QualityCheckedBy")
  changeOrders      ProjectChangeOrder[]   @relation("ChangeOrderCreatedBy")
  deliveryProofs    ProjectDeliveryProof[] @relation("DeliveryProofCreatedBy")
  commissions       SalesCommission[]
  purchaseOrders    PurchaseOrder[]        @relation("PurchaseOrderCreatedBy")
  privacyRequests   PrivacyRequest[]       @relation("PrivacyRequestCreatedBy")
  alertStates       UserAlertState[]
}

model UserAlertState {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertId      String
  fingerprint  String
  readAt       DateTime?
  snoozedUntil DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, alertId])
  @@index([userId, snoozedUntil])
}

model Client {
  id                         String           @id @default(cuid())
  managerId                  String?
  manager                    User?            @relation(fields: [managerId], references: [id], onDelete: SetNull)
  name                       String
  document                   String?
  documentNormalized         String?
  phone                      String?
  phoneNormalized            String?
  whatsapp                   String?
  whatsappNormalized         String?
  email                      String?
  emailNormalized            String?
  address                    String?
  street                     String?
  number                     String?
  neighborhood               String?
  city                       String?
  state                      String?
  zipCode                    String?
  latitude                   Float?
  longitude                  Float?
  geocodedAt                 DateTime?
  notes                      String?
  relationshipStage          String           @default("CONTACT")
  relationshipStageChangedAt DateTime         @default(now())
  lastCommercialActivityAt   DateTime?
  inactivatedAt              DateTime?
  inactiveReason             String?
  commercialSource           String?
  nextCommercialAction       String?
  nextCommercialActionAt     DateTime?
  archivedAt                 DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  projects                   Project[]
  quotes                     Quote[]
  quoteGroups                QuoteGroup[]
  privacyRequests            PrivacyRequest[]

  @@index([name])
  @@index([managerId])
  @@index([city])
  @@index([zipCode])
  @@index([archivedAt])
  @@index([documentNormalized])
  @@index([phoneNormalized])
  @@index([whatsappNormalized])
  @@index([emailNormalized])
  @@index([relationshipStage, archivedAt])
  @@index([managerId, relationshipStage, archivedAt])
  @@index([lastCommercialActivityAt])
  @@index([nextCommercialActionAt, relationshipStage])
}

model Project {
  id                             String                 @id @default(cuid())
  clientId                       String
  client                         Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name                           String
  room                           String?
  status                         String                 @default("APPROVED")
  stage                          String                 @default("PENDING_START")
  approvalDate                   DateTime?
  paymentConfirmedAt             DateTime?
  deliveryBusinessDays           Int                    @default(30)
  deliveryDeadlineDate           DateTime?
  productionReminderBusinessDays Int                    @default(7)
  productionStartReminderDate    DateTime?
  startDate                      DateTime?
  estimatedEndDate               DateTime?
  actualEndDate                  DateTime?
  value                          Decimal?               @db.Decimal(14, 2)
  productionCost                 Decimal?               @default(0) @db.Decimal(14, 2)
  paymentMethod                  String                 @default("TO_DEFINE")
  paymentDiscount                Decimal                @default(0) @db.Decimal(14, 2)
  cardFeePercent                 Float                  @default(0)
  cardFeeAmount                  Decimal                @default(0) @db.Decimal(14, 2)
  downPayment                    Decimal?               @default(0) @db.Decimal(14, 2)
  downPaymentDate                DateTime?
  installmentCount               Int                    @default(0)
  installmentValue               Decimal?               @default(0) @db.Decimal(14, 2)
  firstInstallmentDate           DateTime?
  managerId                      String?
  manager                        User?                  @relation(fields: [managerId], references: [id])
  internalNotes                  String?
  productionBlockedAt            DateTime?
  productionBlockReason          String?
  stageDeadlineDate              DateTime?
  contractRequirement            String                 @default("REQUIRED")
  contractWaivedAt               DateTime?
  contractWaivedReason           String?
  contractWaivedById             String?
  contractWaivedBy               User?                  @relation("ContractWaivedBy", fields: [contractWaivedById], references: [id], onDelete: SetNull)
  contractRevisionRequiredAt     DateTime?
  contractRevisionChanges        Json?
  archivedAt                     DateTime?
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  notes                          Note[]
  files                          ProjectFile[]
  timeline                       TimelineEvent[]
  activities                     ActivityLog[]
  payments                       ProjectPayment[]
  checklist                      ProjectChecklistItem[]
  environments                   ProjectEnvironment[]
  sourceQuote                    Quote?                 @relation("QuoteConvertedProject")
  materials                      ProjectMaterial[]
  expenses                       ProjectExpense[]
  installationSchedules          InstallationSchedule[]
  portalAccesses                 ProjectPortalAccess[]
  contracts                      ProjectContract[]
  warrantyTickets                WarrantyTicket[]
  cutPieces                      ProjectCutPiece[]
  timeEntries                    ProjectTimeEntry[]
  qualityChecks                  ProjectQualityCheck[]
  changeOrders                   ProjectChangeOrder[]
  deliveryProofs                 ProjectDeliveryProof[]
  inventoryReservations          InventoryReservation[]
  purchaseOrderItems             PurchaseOrderItem[]
  commissions                    SalesCommission[]
  productionWeight               Float                  @default(1)
  postSaleFollowUpAt             DateTime?
  postSaleContactedAt            DateTime?
  warrantyEndsAt                 DateTime?
  satisfactionRating             Int?
  satisfactionComment            String?
  satisfactionRespondedAt        DateTime?

  @@index([status])
  @@index([stage])
  @@index([managerId])
  @@index([estimatedEndDate])
  @@index([approvalDate])
  @@index([paymentConfirmedAt])
  @@index([paymentMethod])
  @@index([deliveryDeadlineDate])
  @@index([productionStartReminderDate])
  @@index([stage, postSaleFollowUpAt])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([productionBlockedAt])
  @@index([stageDeadlineDate])
  @@index([contractRequirement])
  @@index([contractWaivedById])
  @@index([contractRevisionRequiredAt])
}

model Quote {
  id                         String                 @id @default(cuid())
  number                     Int                    @unique @default(autoincrement())
  groupId                    String
  group                      QuoteGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  clientId                   String
  client                     Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdById                String?
  createdBy                  User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  convertedProjectId         String?                @unique
  convertedProject           Project?               @relation("QuoteConvertedProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)
  title                      String
  variationType              String                 @default("STANDARD")
  variationName              String                 @default("Padrão")
  variationOrder             Int                    @default(0)
  status                     String                 @default("DRAFT")
  validUntil                 DateTime?
  deliveryBusinessDays       Int                    @default(30)
  firstInstallmentDate       DateTime?
  pricePerM2                 Decimal                @default(1250) @db.Decimal(14, 2)
  materialCostPerM2          Decimal                @default(650) @db.Decimal(14, 2)
  installationFee            Decimal                @default(0) @db.Decimal(14, 2)
  marginPercent              Float                  @default(35)
  discount                   Decimal                @default(0) @db.Decimal(14, 2)
  manualDiscount             Decimal                @default(0) @db.Decimal(14, 2)
  paymentDiscount            Decimal                @default(0) @db.Decimal(14, 2)
  paymentMethod              String                 @default("TO_DEFINE")
  cardInstallments           Int                    @default(1)
  cardDownPayment            Decimal                @default(0) @db.Decimal(14, 2)
  cardFeePercent             Float                  @default(0)
  cardFeeAmount              Decimal                @default(0) @db.Decimal(14, 2)
  subtotal                   Decimal                @default(0) @db.Decimal(14, 2)
  costTotal                  Decimal                @default(0) @db.Decimal(14, 2)
  total                      Decimal                @default(0) @db.Decimal(14, 2)
  notes                      String?
  customerNotes              String?
  lossReason                 String?
  sentAt                     DateTime?
  approvedAt                 DateTime?
  soldAt                     DateTime?
  lostAt                     DateTime?
  viewedAt                   DateTime?
  viewCount                  Int                    @default(0)
  archivedAt                 DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  items                      QuoteItem[]
  revisions                  QuoteRevision[]
  approvalRequests           QuoteApprovalRequest[] @relation("QuoteApprovalPrimary")
  comparisonApprovalRequests QuoteApprovalRequest[] @relation("QuoteApprovalComparison")
  selectedApprovalRequests   QuoteApprovalRequest[] @relation("QuoteApprovalSelected")
  approvalOptions            QuoteApprovalOption[]

  @@unique([groupId, variationOrder])
  @@index([groupId])
  @@index([clientId])
  @@index([createdById])
  @@index([status])
  @@index([validUntil])
  @@index([createdAt])
  @@index([createdById, status, createdAt])
  @@index([archivedAt])
}

model QuoteGroup {
  id          String                  @id @default(cuid())
  clientId    String
  client      Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdById String?
  createdBy   User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title       String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  quotes      Quote[]
  images      QuoteEnvironmentImage[]

  @@index([clientId])
  @@index([createdById])
  @@index([updatedAt])
}

model QuoteEnvironmentImage {
  id                String     @id @default(cuid())
  groupId           String
  group             QuoteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  environmentName   String
  name              String
  caption           String?
  type              String
  url               String     @unique
  size              Int?
  securityStatus    String     @default("PENDING")
  securityDetails   String?
  securityCheckedAt DateTime?
  position          Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([groupId, environmentName, position])
}

model CompanyProfile {
  id                          String   @id @default("vertex")
  tradeName                   String   @default("Vertex Móveis")
  legalName                   String?
  document                    String?
  phone                       String?
  email                       String?
  street                      String?
  number                      String?
  complement                  String?
  neighborhood                String?
  city                        String?
  state                       String?
  zipCode                     String?
  defaultDeliveryBusinessDays Int      @default(30)
  quoteReminderDays           Int      @default(3)
  leadNoResponseDays          Int      @default(30)
  leadCloseSuggestionDays     Int      @default(90)
  weeklyProductionCapacity    Int      @default(4)
  standardSheetWidthMm        Int      @default(2750)
  standardSheetHeightMm       Int      @default(1850)
  sheetWastePercent           Float    @default(15)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model QuoteItem {
  id              String   @id @default(cuid())
  quoteId         String
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  environment     String
  environmentName String?
  description     String
  furnitureType   String?
  furnitureModel  String?
  placement       String?
  sourceItemKey   String
  material        String?
  finish          String?
  width           Float
  height          Float
  depth           Float?
  difficulty      String   @default("NORMAL")
  calculationMode String   @default("AREA_M2")
  priceProfile    String   @default("STANDARD")
  manualPrice     Decimal? @db.Decimal(14, 2)
  accessories     String?
  quantity        Int      @default(1)
  areaM2          Float    @default(0)
  unitPrice       Decimal  @default(0) @db.Decimal(14, 2)
  cost            Decimal  @default(0) @db.Decimal(14, 2)
  total           Decimal  @default(0) @db.Decimal(14, 2)
  notes           String?
  position        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([quoteId])
  @@index([environment])
  @@index([sourceItemKey])
}

model QuoteRevision {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  String
  createdAt DateTime @default(now())

  @@unique([quoteId, version])
  @@index([quoteId])
}

model QuotePriceRule {
  id                String    @id @default(cuid())
  name              String
  environment       String?
  furnitureType     String?
  furnitureModel    String?
  priceProfile      String?
  calculationMode   String    @default("AREA_M2")
  pricePerM2        Decimal   @db.Decimal(14, 2)
  materialCostPerM2 Decimal?  @db.Decimal(14, 2)
  validFrom         DateTime  @default(now())
  validUntil        DateTime?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([active, validFrom, validUntil])
  @@index([environment, furnitureType, furnitureModel])
}

model MaterialCatalogItem {
  id                 String                  @id @default(cuid())
  name               String                  @unique
  category           String?
  defaultFinish      String?
  unit               String                  @default("m2")
  unitCost           Decimal                 @default(0) @db.Decimal(14, 2)
  supplier           String?
  active             Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  projectMaterials   ProjectMaterial[]
  supplierPrices     MaterialSupplierPrice[]
  reservations       InventoryReservation[]
  purchaseOrderItems PurchaseOrderItem[]
  stockQuantity      Float                   @default(0)
  minimumStock       Float                   @default(0)
  location           String?

  @@index([active])
  @@index([category])
  @@index([active, stockQuantity])
}

model MaterialSupplierPrice {
  id         String              @id @default(cuid())
  materialId String
  material   MaterialCatalogItem @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier   String
  unitCost   Decimal             @db.Decimal(14, 2)
  quotedAt   DateTime            @default(now())
  notes      String?
  createdAt  DateTime            @default(now())

  @@index([materialId, quotedAt])
  @@index([supplier])
}

model ProjectMaterial {
  id                 String               @id @default(cuid())
  projectId          String
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId         String?
  material           MaterialCatalogItem? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  materialName       String
  finish             String?
  unit               String               @default("m2")
  estimatedQuantity  Float                @default(0)
  purchasedQuantity  Float                @default(0)
  estimatedCost      Decimal              @default(0) @db.Decimal(14, 2)
  actualCost         Decimal?             @db.Decimal(14, 2)
  supplier           String?
  status             String               @default("PENDING")
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  purchaseOrderItems PurchaseOrderItem[]

  @@index([projectId])
  @@index([status])
  @@index([materialId])
}

model ProjectExpense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String
  description String
  amount      Decimal  @db.Decimal(14, 2)
  incurredAt  DateTime
  supplier    String?
  notes       String?
  createdById String?
  createdBy   User?    @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([category])
  @@index([incurredAt])
  @@index([createdById])
}

model OperationalResource {
  id               String                 @id @default(cuid())
  name             String
  type             String
  active           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  teamSchedules    InstallationSchedule[] @relation("ScheduleTeam")
  vehicleSchedules InstallationSchedule[] @relation("ScheduleVehicle")

  @@unique([type, name])
  @@index([active, type])
}

model InstallationSchedule {
  id                 String                @id @default(cuid())
  projectId          String
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scheduledStart     DateTime
  scheduledEnd       DateTime
  teamId             String?
  team               OperationalResource?  @relation("ScheduleTeam", fields: [teamId], references: [id], onDelete: SetNull)
  vehicleId          String?
  vehicle            OperationalResource?  @relation("ScheduleVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  status             String                @default("SCHEDULED")
  notes              String?
  departureAt        DateTime?
  arrivalAt          DateTime?
  completedAt        DateTime?
  clientConfirmation String?
  completionNotes    String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deliveryProof      ProjectDeliveryProof?

  @@index([projectId])
  @@index([scheduledStart, scheduledEnd])
  @@index([teamId, scheduledStart])
  @@index([vehicleId, scheduledStart])
  @@index([status, scheduledStart])
}

model ProjectCutPiece {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation("CutPieceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  environment String?
  label       String
  material    String
  finish      String?
  widthMm     Float
  heightMm    Float
  quantity    Int      @default(1)
  grain       Boolean  @default(false)
  status      String   @default("PLANNED")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, status])
  @@index([material, finish])
}

model ProjectTimeEntry {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  phase     String
  startedAt DateTime
  endedAt   DateTime?
  minutes   Int       @default(0)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId, startedAt])
  @@index([userId, endedAt])
  @@index([phase, startedAt])
}

model ProjectQualityCheck {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key         String
  label       String
  status      String    @default("PENDING")
  notes       String?
  checkedById String?
  checkedBy   User?     @relation("QualityCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)
  checkedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, key])
  @@index([projectId, status])
}

model ProjectChangeOrder {
  id                   String    @id @default(cuid())
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById          String?
  createdBy            User?     @relation("ChangeOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  title                String
  description          String
  amountDelta          Decimal   @default(0) @db.Decimal(14, 2)
  daysDelta            Int       @default(0)
  status               String    @default("DRAFT")
  approvedAt           DateTime?
  clientRespondedAt    DateTime?
  clientRespondentName String?
  clientResponseNote   String?
  clientResponseIpHash String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([projectId, status])
}

model ProjectDeliveryProof {
  id                     String                @id @default(cuid())
  projectId              String
  project                Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installationScheduleId String?               @unique
  installationSchedule   InstallationSchedule? @relation(fields: [installationScheduleId], references: [id], onDelete: SetNull)
  createdById            String?
  createdBy              User?                 @relation("DeliveryProofCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy            String
  checklist              Json
  notes                  String?
  deliveredAt            DateTime              @default(now())
  createdAt              DateTime              @default(now())

  @@index([projectId, deliveredAt])
}

model InventoryReservation {
  id         String              @id @default(cuid())
  projectId  String
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId String
  material   MaterialCatalogItem @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity   Float
  status     String              @default("ACTIVE")
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([projectId, materialId])
  @@index([materialId, status])
  @@index([projectId, status])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  supplier    String
  status      String              @default("DRAFT")
  expectedAt  DateTime?
  notes       String?
  createdById String?
  createdBy   User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, expectedAt])
  @@index([supplier, createdAt])
}

model PurchaseOrderItem {
  id                String              @id @default(cuid())
  orderId           String
  order             PurchaseOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId        String
  material          MaterialCatalogItem @relation(fields: [materialId], references: [id], onDelete: Restrict)
  projectId         String?
  project           Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectMaterialId String?
  projectMaterial   ProjectMaterial?    @relation(fields: [projectMaterialId], references: [id], onDelete: SetNull)
  quantity          Float
  receivedQuantity  Float               @default(0)
  unitCost          Decimal             @default(0) @db.Decimal(14, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([orderId])
  @@index([materialId])
  @@index([projectId])
  @@index([projectMaterialId])
}

model SalesCommission {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  percent     Float
  amount      Decimal   @db.Decimal(14, 2)
  status      String    @default("PENDING")
  availableAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, userId])
  @@index([userId, status])
  @@index([status, availableAt])
}

model PrivacyRequest {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("PrivacyRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  type        String
  status      String    @default("OPEN")
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId, status])
  @@index([status, createdAt])
}

model QuoteApprovalRequest {
  id                        String                @id @default(cuid())
  quoteId                   String
  quote                     Quote                 @relation("QuoteApprovalPrimary", fields: [quoteId], references: [id], onDelete: Cascade)
  comparisonQuoteId         String?
  comparisonQuote           Quote?                @relation("QuoteApprovalComparison", fields: [comparisonQuoteId], references: [id], onDelete: SetNull)
  selectedQuoteId           String?
  selectedQuote             Quote?                @relation("QuoteApprovalSelected", fields: [selectedQuoteId], references: [id], onDelete: SetNull)
  token                     String                @unique
  sentAt                    DateTime              @default(now())
  viewedAt                  DateTime?
  viewCount                 Int                   @default(0)
  reminderCount             Int                   @default(0)
  lastReminderAt            DateTime?
  approvedAt                DateTime?
  rejectedAt                DateTime?
  expiresAt                 DateTime?
  invalidatedAt             DateTime?
  snapshot                  String?
  revisionVersion           Int?
  comparisonRevisionVersion Int?
  responseIpHash            String?
  responseUserAgent         String?
  responseNote              String?
  responseName              String?
  responseDocument          String?
  acceptedTermsAt           DateTime?
  message                   String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  options                   QuoteApprovalOption[]

  @@index([quoteId])
  @@index([comparisonQuoteId])
  @@index([selectedQuoteId])
  @@index([expiresAt])
  @@index([invalidatedAt])
  @@index([sentAt])
}

model QuoteApprovalOption {
  id              String               @id @default(cuid())
  requestId       String
  request         QuoteApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quoteId         String
  quote           Quote                @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  revisionVersion Int?
  position        Int
  createdAt       DateTime             @default(now())

  @@unique([requestId, quoteId])
  @@unique([requestId, position])
  @@index([quoteId])
}

model ProjectEnvironment {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  status      String    @default("PENDING")
  position    Int
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, position])
  @@index([projectId])
  @@index([status])
  @@index([completedAt])
}

model ProjectPayment {
  id                String           @id @default(cuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installmentNumber Int
  type              String
  amount            Decimal          @db.Decimal(14, 2)
  dueDate           DateTime
  paidAt            DateTime?
  paymentMethod     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  history           PaymentHistory[]

  @@unique([projectId, type, installmentNumber])
  @@index([projectId])
  @@index([dueDate])
  @@index([paidAt])
  @@index([paymentMethod])
}

model PaymentHistory {
  id        String         @id @default(cuid())
  paymentId String
  payment   ProjectPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  method    String?
  amount    Decimal        @db.Decimal(14, 2)
  createdAt DateTime       @default(now())

  @@index([paymentId])
  @@index([userId])
  @@index([createdAt])
}

model ProjectChecklistItem {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  position    Int
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, position])
  @@index([projectId])
  @@index([completedAt])
}

model Note {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model ProjectFile {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  warrantyTicketId  String?
  warrantyTicket    WarrantyTicket? @relation(fields: [warrantyTicketId], references: [id], onDelete: SetNull)
  name              String
  type              String
  category          String          @default("OTHER")
  url               String
  size              Int?
  securityStatus    String          @default("PENDING")
  securityCheckedAt DateTime?
  securityDetails   String?
  expiresAt         DateTime?
  createdAt         DateTime        @default(now())

  @@unique([projectId, url])
  @@index([projectId, category])
  @@index([warrantyTicketId])
  @@index([securityStatus])
  @@index([expiresAt])
}

model WhatsAppMessage {
  id                String    @id @default(cuid())
  dedupeKey         String    @unique
  kind              String
  recipient         String
  clientName        String?
  quoteId           String?
  projectId         String?
  paymentId         String?
  templateName      String
  status            String    @default("PENDING")
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([providerMessageId])
  @@index([quoteId])
  @@index([projectId])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event       String
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model SystemEvent {
  id        String   @id @default(cuid())
  type      String
  severity  String   @default("INFO")
  source    String
  message   String
  details   Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([severity, createdAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  reason    String?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([success, createdAt])
  @@index([createdAt])
}

model ProjectPortalAccess {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  tokenEncrypted String
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastViewedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([projectId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model ProjectContract {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById       String?
  createdBy         User?     @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  version           Int       @default(1)
  status            String    @default("DRAFT")
  tokenHash         String    @unique
  tokenEncrypted    String
  snapshot          Json
  sentAt            DateTime?
  viewedAt          DateTime?
  lastReminderAt    DateTime?
  reminderCount     Int       @default(0)
  expiresAt         DateTime?
  signedAt          DateTime?
  voidedAt          DateTime?
  signatoryName     String?
  signatoryDocument String?
  acceptedIpHash    String?
  acceptedUserAgent String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([projectId, version])
  @@index([projectId, status])
  @@index([expiresAt])
  @@index([viewedAt])
  @@index([lastReminderAt])
}

model WarrantyTicket {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?         @relation("WarrantyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?         @relation("WarrantyAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  title        String
  description  String
  priority     String        @default("NORMAL")
  status       String        @default("OPEN")
  openedAt     DateTime      @default(now())
  dueAt        DateTime?
  scheduledAt  DateTime?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  files        ProjectFile[]

  @@index([projectId, status])
  @@index([status, priority, openedAt])
  @@index([assignedToId, status])
  @@index([scheduledAt])
  @@index([status, dueAt])
}
